  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx api/index.ts",
    "start": "tsx api/index.ts",
    "build": "vite build && node scripts/voorrender-schil.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "lint:design": "node scripts/design-lint.mjs",
