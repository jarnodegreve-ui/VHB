    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=\"iPhone 13 (chromium)\" --project=\"Desktop (chromium)\" --project=\"iPhone 13 (webkit)\"",
    "test:e2e:pwa": "playwright test --project=pwa",
    "audit:mobile": "node scripts/mobile-audit.mjs",
    "changelog": "node scripts/changelog.mjs",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
