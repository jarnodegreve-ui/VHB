# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# App Configuration
APP_URL=https://ais-dev-iltbw5z47nfae2znuajslh-108241592659.europe-west3.run.app

# OCPI 2.2.1 — read-only monitoring van de Kempower-laadpalen (ChargEye = CPO,
# dit portaal = eMSP). Zie api/ocpi.ts + supabase/ocpi_registration.sql.
# ChargEye's versions-endpoint (uit het ChargEye-integratiescherm):
OCPI_CPO_VERSIONS_URL=https://kempower.io/api/ocpi/versions
# Token A: genereer in ChargEye (Credentials exchange) en plak hier. Eenmalig;
# na de handshake gebruikt de server automatisch de Token C die ChargEye teruggeeft.
OCPI_TOKEN_A=
# Onze eMSP-identiteit (moet matchen met wat in ChargEye is ingevuld):
OCPI_COUNTRY_CODE=BE
OCPI_PARTY_ID=VHB
OCPI_BUSINESS_NAME=VHB Portaal
# Publieke basis-URL van dit portaal (zodat ChargEye onze OCPI-endpoints bereikt):
OCPI_PUBLIC_BASE_URL=https://vhb-five.vercel.app
