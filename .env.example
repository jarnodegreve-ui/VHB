# SMTP — urgente updates, verlofbeslissingen, foutmelding-digest en de
# wekelijkse off-site back-upmail. STARTTLS wordt afgedwongen (requireTLS in
# api/email.ts); SMTP_SECURE=true alleen voor impliciete-TLS-poorten (465).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_username
SMTP_PASS=your_password
SMTP_SECURE=false
SMTP_FROM=noreply@vhbportaal.be

# Ontvanger(s) van alertmails (komma-gescheiden): foutmelding-digest en de
# wekelijkse back-upmail. LET OP: die back-upmail bevat de volledige export
# (incl. gebruikerslijst) — gebruik een mailbox die je vertrouwt en beheert.
# Leeg = fallback naar alle actieve admin-accounts.
ALERT_EMAIL=

# Retentie (nachtcron, na de back-up): client-fouten en auditlog ouder dan
# dit aantal dagen worden opgeruimd. Leeg = defaults (30 / 365).
RETENTION_ERROR_DAYS=
RETENTION_LOG_DAYS=

# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# App Configuration — publieke basis-URL voor maillinks (wachtwoord-reset etc.)
APP_URL=https://vhbportaal.com

# Web Push (meldingen naar chauffeurs). Genereer een VAPID-sleutelpaar
# (bv. `npx web-push generate-vapid-keys`); zonder deze verbergt de app de
# meldingen-knop en verstuurt hij geen push. De client haalt de publieke
# sleutel via /api/push/public-key op (geen VITE_-variant nodig).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@vhbportaal.be

# Cron-beveiliging: gedeeld geheim voor /api/cron/* (Bearer <CRON_SECRET>).
CRON_SECRET=
# HMAC-sleutel voor de persoonlijke agenda-feed-tokens (/api/calendar/...).
CALENDAR_FEED_SECRET=

# Rate limiting (optioneel — leeg = defaults). Venster + max per token/IP.
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=
RATE_LIMIT_ANON_MAX=
RATE_LIMIT_IP_MAX=
RATE_LIMIT_ERRORS_MAX=

# Foutmelding-digest (cron): interval + drempel vóór een alertmail. Leeg = defaults.
ERROR_DIGEST_INTERVAL_MIN=
ERROR_DIGEST_MIN_COUNT=

# Users-cache TTL in ms (auth-hot-path; leeg = default).
USER_CACHE_TTL_MS=

# OCPI 2.2.1 — read-only monitoring van de Kempower-laadpalen (ChargEye = CPO,
# dit portaal = eMSP). Zie api/ocpi.ts + supabase/ocpi_registration.sql.
# ChargEye's versions-endpoint (uit het ChargEye-integratiescherm):
OCPI_CPO_VERSIONS_URL=https://kempower.io/api/ocpi/versions
# Token A: genereer in ChargEye (Credentials exchange) en plak hier. Eenmalig;
# na de handshake gebruikt de server automatisch de Token C die ChargEye teruggeeft.
OCPI_TOKEN_A=
# Onze eMSP-identiteit (moet matchen met wat in ChargEye is ingevuld):
OCPI_COUNTRY_CODE=BE
OCPI_PARTY_ID=VHB
OCPI_BUSINESS_NAME=VHB Portaal
# Publieke basis-URL van dit portaal (zodat ChargEye onze OCPI-endpoints bereikt):
OCPI_PUBLIC_BASE_URL=https://vhb-five.vercel.app

# Gedeelde rate-limit-store (optioneel, Upstash Redis REST).
# Zonder deze twee vars telt de limiet per serverless-instantie; mét een
# gedeelde store geldt hij globaal. Storing/timeout → automatische fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
