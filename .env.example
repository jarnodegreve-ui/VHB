# SMTP — urgente updates, verlofbeslissingen, foutmelding-digest en de
# wekelijkse off-site back-upmail. STARTTLS wordt afgedwongen (requireTLS in
# api/email.ts); SMTP_SECURE=true alleen voor impliciete-TLS-poorten (465).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_username
SMTP_PASS=your_password
SMTP_SECURE=false
SMTP_FROM=noreply@vhbportaal.be

# Ontvanger(s) van alertmails (komma-gescheiden): foutmelding-digest en de
# wekelijkse back-upmail. LET OP: die back-upmail bevat de volledige export
# (incl. gebruikerslijst) — gebruik een mailbox die je vertrouwt en beheert.
# Leeg = fallback naar alle actieve admin-accounts.
ALERT_EMAIL=

# Retentie (nachtcron, na de back-up): client-fouten, auditlog en
# dienstnotities ouder dan dit aantal dagen worden opgeruimd.
# Leeg = defaults (30 / 365 / 90).
RETENTION_ERROR_DAYS=
RETENTION_LOG_DAYS=
RETENTION_NOTE_DAYS=

# Wachtwoordzin voor de versleutelde back-upbijlage (.json.enc) in de
# wekelijkse off-site mail; zonder deze wordt er NIET gemaild (fail-closed).
# Ontsleutelen: zie docs/RESTORE.md.
BACKUP_PASSPHRASE=

# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# App Configuration — publieke basis-URL voor maillinks (wachtwoord-reset etc.)
APP_URL=https://vhbportaal.com

# Web Push (meldingen naar chauffeurs). Genereer een VAPID-sleutelpaar
# (bv. `npx web-push generate-vapid-keys`); zonder deze verbergt de app de
# meldingen-knop en verstuurt hij geen push. De client haalt de publieke
# sleutel via /api/push/public-key op (geen VITE_-variant nodig).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@vhbportaal.be

# Cron-beveiliging: gedeeld geheim voor /api/cron/* (Bearer <CRON_SECRET>).
CRON_SECRET=
# Eigen geheim voor GET /api/rostering-export (roostersolver vhb-planner op
# Render). Zolang dit leeg is werkt CRON_SECRET daar nog als overgang; zet het
# hier én op Render, dan werkt alleen dit nog.
ROSTERING_EXPORT_SECRET=
# HMAC-sleutel voor de persoonlijke agenda-feed-tokens (/api/calendar/...).
CALENDAR_FEED_SECRET=

# Rate limiting (optioneel — leeg = defaults). Venster + max per token/IP.
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=
RATE_LIMIT_ANON_MAX=
RATE_LIMIT_IP_MAX=
RATE_LIMIT_ERRORS_MAX=
# Actie-limieten per gebruiker: venster in ms (default 1 uur), max toestel-
# registraties (12) en max bedrijfsbrede noodmails (6) per venster.
RATE_LIMIT_ACTION_WINDOW_MS=
RATE_LIMIT_DEVICE_MAX=
RATE_LIMIT_URGENT_MAX=

# Foutmelding-digest (cron): interval + drempel vóór een alertmail. Leeg = defaults.
ERROR_DIGEST_INTERVAL_MIN=
ERROR_DIGEST_MIN_COUNT=
# Weekdag voor de foutmail (0 = zondag … 6 = zaterdag; standaard 1 = maandag, 'elke' = dagelijks).
ERROR_DIGEST_WEEKDAG=

# Users-cache TTL in ms (auth-hot-path; leeg = default 30 s), en hoe vaak (ms)
# een instantie de gedeelde revocatie-epoch in Upstash controleert (default 2 s).
USER_CACHE_TTL_MS=
USER_CACHE_EPOCH_CHECK_MS=

# Planner-assistent (/api/planner-chat, Anthropic). Zonder sleutel geeft de
# assistent een nette 503; het model is zonder code-wijziging om te schakelen.
ANTHROPIC_API_KEY=
PLANNER_CHAT_MODEL=claude-sonnet-5

# Telegram-bot (meldingen + commando's naar de gekoppelde planner-chat).
# Token van BotFather; webhook-secret zelf genereren en aan setWebhook
# meegeven; chat-id toont /start zolang hij nog niet ingesteld is; actor =
# het portaal-user-id waaronder bot-acties gelogd worden (leeg = placeholder).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHAT_ID=
TELEGRAM_ACTOR_USER_ID=
# Proactieve Telegram-meldingen (briefing, verlof/ruil, ziek, gaten): 'aan' of leeg = uit. Bot-antwoorden werken altijd.
TELEGRAM_MELDINGEN=

# OCPI 2.2.1 — read-only monitoring van de Kempower-laadpalen (ChargEye = CPO,
# dit portaal = eMSP). Zie api/ocpi.ts + supabase/ocpi_registration.sql.
# ChargEye's versions-endpoint (uit het ChargEye-integratiescherm):
OCPI_CPO_VERSIONS_URL=https://kempower.io/api/ocpi/versions
# Token A: genereer in ChargEye (Credentials exchange) en plak hier. Eenmalig;
# na de handshake gebruikt de server automatisch de Token C die ChargEye teruggeeft.
OCPI_TOKEN_A=
# Onze eMSP-identiteit (moet matchen met wat in ChargEye is ingevuld):
OCPI_COUNTRY_CODE=BE
OCPI_PARTY_ID=VHB
OCPI_BUSINESS_NAME=VHB Portaal
# Publieke basis-URL van dit portaal (zodat ChargEye onze OCPI-endpoints bereikt):
OCPI_PUBLIC_BASE_URL=https://vhb-five.vercel.app
# Extra toegestane https-hosts (komma-gescheiden) voor OCPI-URL's naast de
# host van de versions-URL, bv. een apart CDN voor paginering. Leeg = geen.
OCPI_ALLOWED_HOSTS=

# Gedeelde rate-limit-store (optioneel, Upstash Redis REST).
# Zonder deze twee vars telt de limiet per serverless-instantie; mét een
# gedeelde store geldt hij globaal. Storing/timeout → automatische fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
