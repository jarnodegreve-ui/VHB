# SMTP — urgente updates, verlofbeslissingen, foutmelding-digest en de
# wekelijkse off-site back-upmail. STARTTLS wordt afgedwongen (requireTLS in
# api/email.ts); SMTP_SECURE=true alleen voor impliciete-TLS-poorten (465).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_username
SMTP_PASS=your_password
SMTP_SECURE=false
SMTP_FROM=noreply@vhbportaal.be

# Ontvanger(s) van alertmails (komma-gescheiden): foutmelding-digest en de
# wekelijkse back-upmail. LET OP: die back-upmail bevat de volledige export
# (incl. gebruikerslijst) — gebruik een mailbox die je vertrouwt en beheert.
# Leeg = fallback naar alle actieve admin-accounts.
ALERT_EMAIL=

# Retentie (nachtcron, na de back-up): client-fouten en auditlog ouder dan
# dit aantal dagen worden opgeruimd. Leeg = defaults (30 / 365).
RETENTION_ERROR_DAYS=
RETENTION_LOG_DAYS=

# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# App Configuration
APP_URL=https://ais-dev-iltbw5z47nfae2znuajslh-108241592659.europe-west3.run.app

# OCPI 2.2.1 — read-only monitoring van de Kempower-laadpalen (ChargEye = CPO,
# dit portaal = eMSP). Zie api/ocpi.ts + supabase/ocpi_registration.sql.
# ChargEye's versions-endpoint (uit het ChargEye-integratiescherm):
OCPI_CPO_VERSIONS_URL=https://kempower.io/api/ocpi/versions
# Token A: genereer in ChargEye (Credentials exchange) en plak hier. Eenmalig;
# na de handshake gebruikt de server automatisch de Token C die ChargEye teruggeeft.
OCPI_TOKEN_A=
# Onze eMSP-identiteit (moet matchen met wat in ChargEye is ingevuld):
OCPI_COUNTRY_CODE=BE
OCPI_PARTY_ID=VHB
OCPI_BUSINESS_NAME=VHB Portaal
# Publieke basis-URL van dit portaal (zodat ChargEye onze OCPI-endpoints bereikt):
OCPI_PUBLIC_BASE_URL=https://vhb-five.vercel.app
