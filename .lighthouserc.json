{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/lighthouse-server.mjs --port 4191",
      "startServerReadyPattern": "Lighthouse-server luistert",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:4191/",
        "http://localhost:4191/mijn-dag"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": { "mobile": true, "width": 390, "height": 844, "deviceScaleFactor": 3, "disabled": false },
        "throttlingMethod": "simulate",
        "onlyCategories": ["performance", "accessibility", "best-practices"],
        "chromeFlags": "--headless=new --no-sandbox --disable-gpu"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:4191/$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 300 }]
          }
        },
        {
          "matchingUrlPattern": "/mijn-dag$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.8 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 300 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/rapporten",
      "reportFilenamePattern": "%%PATHNAME%%-%%DATETIME%%.%%EXTENSION%%"
    }
  }
}
