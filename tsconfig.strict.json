{
  // Strict in fases (golf 4, punt 20): de hoofd-tsconfig heeft geen `strict`,
  // en de rest van src/ telt honderden strict-fouten (meting in de PR). Dit
  // deelproject zet `strict` aan voor de code zonder React-schil: de gedeelde
  // contracten en de pure lib-modules. `npm run lint:strict` draait hem, ook
  // in CI (job checks). Nieuwe lib-/shared-modules horen strict te zijn; een
  // volgende fase breidt `include` uit (src/app/data, dan components, dan
  // views). Bestanden die via import worden meegetrokken maar buiten de
  // include vallen, worden wél gecontroleerd: dat is de bedoeling (het zijn
  // de afhankelijkheden van strict-code), maar houd de kring klein.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true
  },
  "include": ["shared", "src/lib", "src/vite-env.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "rostering",
    "coverage",
    "playwright-report",
    // Golf-4-bestanden van een andere agent (in bewerking tijdens deze golf);
    // haal ze uit deze lijst zodra die golf gemerged is.
    "src/lib/useOnline.ts",
    "src/lib/ruilBadge.ts",
    "src/lib/usePullToRefresh.ts",
    "src/lib/ongedaan.ts",
    "src/lib/tik.ts",
    "src/lib/router.ts"
  ]
}
