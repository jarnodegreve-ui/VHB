{
  "version": 2,
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/error-digest",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/ocpi-sync?parts=all",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/week-rapport",
      "schedule": "3 5 * * 1"
    },
    {
      "path": "/api/cron/restore-proef",
      "schedule": "23 4 1 * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
