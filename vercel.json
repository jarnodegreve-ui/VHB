{
  "version": 2,
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/error-digest",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/telegram-briefing",
      "schedule": "45 4 * * *"
    },
    {
      "path": "/api/cron/ocpi-sync?parts=all",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/week-rapport",
      "schedule": "3 5 * * 1"
    },
    {
      "path": "/api/cron/restore-proef",
      "schedule": "23 4 1 * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-kLzdflUrpk7G+Ov6Ceg4UA1Ky8mk3zMuwp8TXuuA33o='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://nbupdofxuoxvgeiedzkk.supabase.co wss://nbupdofxuoxvgeiedzkk.supabase.co; frame-src 'self' blob: https://nbupdofxuoxvgeiedzkk.supabase.co; worker-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; report-uri /api/csp-report"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
